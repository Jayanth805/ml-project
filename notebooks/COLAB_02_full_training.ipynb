    "# ============================================================\n",
    "# STEP 5: CREATE DATASET\n",
    "# ============================================================\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"CREATING DATASET\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# Generate diverse sample news headlines for training\n",
    "# In reality, you would load the actual Fakeddit dataset here\n",
    "\n",
    "print(\"Generating training dataset...\")\n",
    "\n",
    "# Real-sounding news headlines (labelled based on typical patterns)\n",
    "real_headlines = [\n",
    "    \"Scientists discover new species of deep-sea fish\",\n",
    "    \"NASA announces new Mars mission timeline\",\n",
    "    \"Local community raises funds for new library\",\n",
    "    \"Weather forecast: Sunny skies expected this weekend\",\n",
    "    \"Tech company releases quarterly earnings report\",\n",
    "    \"University researchers publish study on climate change\",\n",
    "    \"City council approves new public transportation route\",\n",
    "    \"Health experts recommend annual flu vaccination\",\n",
    "    \"Stock market closes at record high\",\n",
    "    \"New art exhibition opens at national museum\",\n",
    "    \"Scientists confirm water ice found on moon surface\",\n",
    "    \"Government announces infrastructure investment plan\",\n",
    "    \"Research shows benefits of Mediterranean diet\",\n",
    "    \"International summit addresses climate agreements\",\n",
    "    \"Sports team wins championship after 20 years\",\n",
    "    \"Astronomers detect new exoplanet in habitable zone\",\n",
    "    \"School district implements new technology program\",\n",
    "    \"Medical breakthrough in cancer treatment announced\",\n",
    "    \"Economic indicators show steady growth\",\n",
    "    \"Historic building renovated and reopened to public\"\n",
    "]\n",
    "\n",
    "fake_headlines = [\n",
    "    \"BREAKING: Aliens have secretly been living among us for years\",\n",
    "    \"SHOCKING: Government admits to faking the moon landing\",\n",
    "    \"EXPOSED: Celebrity arrested in massive conspiracy scandal\",\n",
    "    \"URGENT: Doctor reveals secret cure that Big Pharma hides\",\n",
    "    \"WARNING: Your iPhone is secretly recording everything you say\",\n",
    "    \"INCREDIBLE: Scientists discover humans can survive without food\",\n",
    "    \"BOMBSHELL: Hidden camera catches politician in secret meeting\",\n",
    "    \"MUST SEE: Ghost caught on camera in abandoned hospital\",\n",
    "    \"SCANDAL: Famous actor's dark secret finally revealed\",\n",
    "    \"WARNING: Your bank account will be emptied tomorrow unless...\",\n",
    "    \"UNBELIEVABLE: 500-year-old mummy found alive in cave\",\n",
    "    \"LEAKED: Government document proves 9/11 was inside job\",\n",
    "    \"SHOCKING: Eating pizza every day is actually healthy, says study\",\n",
    "    \"BREAKING: Time traveler from 2050 warns of upcoming disaster\",\n",
    "    \"REVEALED: Your sunscreen is actually causing cancer\",\n",
    "    \"INSANE: Man claims he can fly after eating mysterious plant\",\n",
    "    \"BOMBSHELL: Celebrity couple's divorce caused by alien encounter\",\n",
    "    \"URGENT: Massive asteroid heading toward Earth, NASA silent\",\n",
    "    \"EXPOSED: Famous scientist admits all research is fabricated\",\n",
    "    \"INCREDIBLE: Person lives for 200 years, doctors shocked\"\n",
    "]\n",
    "\n",
    "# Create dataset\n",
    "all_headlines = real_headlines + fake_headlines\n",
    "all_labels = [0] * len(real_headlines) + [1] * len(fake_headlines)  # 0=real, 1=fake\n",
    "\n",
    "# Create DataFrame\n",
    "df = pd.DataFrame({\n",
    "    'text': all_headlines,\n",
    "    'image_id': [f'img_{i}' for i in range(len(all_headlines))],\n",
    "    'label': all_labels\n",
    "})\n",
    "\n",
    "# Split into train/val/test\n",
    "train_df, temp_df = train_test_split(df, test_size=0.3, random_state=42, stratify=df['label'])\n",
    "val_df, test_df = train_test_split(temp_df, test_size=0.5, random_state=42, stratify=temp_df['label'])\n",
    "\n",
    "# Save splits\n",
    "train_df.to_csv(PROCESSED_DIR / 'train.csv', index=False)\n",
    "val_df.to_csv(PROCESSED_DIR / 'val.csv', index=False)\n",
    "test_df.to_csv(PROCESSED_DIR / 'test.csv', index=False)\n",
    "\n",
    "print(f\"✅ Dataset created:\")\n",
    "print(f\"   Train: {len(train_df)} samples\")\n",
    "print(f\"   Validation: {len(val_df)} samples\")\n",
    "print(f\"   Test: {len(test_df)} samples\")\n",
    "\n",
    "print(f\"\\n   Real news: {(df['label']==0).sum()}\")\n",
    "print(f\"   Fake news: {(df['label']==1).sum()}\")"
   ]
