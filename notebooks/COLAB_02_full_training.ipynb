    "# ============================================================\n",
    "# STEP 6: DEFINE MODEL ARCHITECTURE\n",
    "# ============================================================\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"DEFINING MODEL\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from transformers import AutoModel, AutoTokenizer, AutoImageProcessor\n",
    "from PIL import Image\n",
    "import numpy as np\n",
    "\n",
    "class MultimodalFakeNewsClassifier(nn.Module):\n",
    "    \"\"\"\n",
    "    Cross-Modal Consistency-Aware Multimodal Fake News Detector\n",
    "    \n",
    "    Architecture:\n",
    "    - Text: BERT for text features\n",
    "    - Image: ViT for visual features\n",
    "    - CLIP: Semantic similarity measurement\n",
    "    - Fusion: Consistency-aware multimodal fusion\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, freeze_encoders=True):\n",
    "        super().__init__()\n",
    "        \n",
    "        # Text encoder (BERT)\n",
    "        self.bert_name = \"google-bert/bert-base-uncased\"\n",
    "        self.bert = AutoModel.from_pretrained(self.bert_name)\n",
    "        \n",
    "        # Image encoder (ViT)\n",
    "        self.vit_name = \"google/vit-base-patch16-224\"\n",
    "        self.vit = AutoModel.from_pretrained(self.vit_name)\n",
    "        \n",
    "        # CLIP for semantic similarity\n",
    "        self.clip_name = \"openai/clip-vit-base-patch32\"\n",
    "        self.clip = AutoModel.from_pretrained(self.clip_name)\n",
    "        self.clip_processor = AutoImageProcessor.from_pretrained(self.clip_name)\n",
    "        \n",
    "        # Freeze encoders\n",
    "        if freeze_encoders:\n",
    "            for param in self.bert.parameters():\n",
    "                param.requires_grad = False\n",
    "            for param in self.vit.parameters():\n",
    "                param.requires_grad = False\n",
    "            for param in self.clip.parameters():\n",
    "                param.requires_grad = False\n",
    "        \n",
    "        # Projection layers (768 -> 256)\n",
    "        self.text_proj = nn.Linear(768, 256)\n",
    "        self.image_proj = nn.Linear(768, 256)\n",
    "        \n",
    "        # Fusion classifier (1025 -> 256 -> 1)\n",
    "        # 256 (text) + 256 (image) + 256 (diff) + 256 (product) + 1 (CLIP sim)\n",
    "        self.fusion = nn.Sequential(\n",
    "            nn.Linear(1025, 256),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(256, 64),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(64, 1)\n",
    "        )\n",
    "        \n",
    "        print(f\"Model initialized with frozen encoders: {freeze_encoders}\")\n",
    "    \n",
    "    def get_bert_features(self, input_ids, attention_mask):\n",
    "        outputs = self.bert(input_ids=input_ids, attention_mask=attention_mask)\n",
    "        return outputs.last_hidden_state[:, 0, :]  # CLS token\n",
    "    \n",
    "    def get_vit_features(self, pixel_values):\n",
    "        outputs = self.vit(pixel_values=pixel_values)\n",
    "        return outputs.last_hidden_state[:, 0, :]  # CLS token\n",
    "    \n",
    "    def get_clip_similarity(self, text_features, image_features):\n",
    "        # Normalize embeddings\n",
    "        text_norm = text_features / text_features.norm(dim=-1, keepdim=True)\n",
    "        image_norm = image_features / image_features.norm(dim=-1, keepdim=True)\n",
    "        # Cosine similarity\n",
    "        return (text_norm * image_norm).sum(dim=-1)\n",
    "    \n",
    "    def forward(self, input_ids, attention_mask, pixel_values, clip_text_embeds, clip_image_embeds):\n",
    "        # Get features\n",
    "        text_features = self.get_bert_features(input_ids, attention_mask)\n",
    "        image_features = self.get_vit_features(pixel_values)\n",
    "        \n",
    "        # Project features\n",
    "        text_proj = self.text_proj(text_features)\n",
    "        image_proj = self.image_proj(image_features)\n",
    "        \n",
    "        # Compute interaction features\n",
    "        abs_diff = torch.abs(text_proj - image_proj)\n",
    "        hadamard_prod = text_proj * image_proj\n",
    "        \n",
    "        # CLIP similarity (use pre-computed or compute)\n",
    "        if clip_text_embeds is not None and clip_image_embeds is not None:\n",
    "            clip_sim = self.get_clip_similarity(clip_text_embeds, clip_image_embeds)\n",
    "        else:\n",
    "            # Fallback: use projected features for similarity\n",
    "            clip_sim = self.get_clip_similarity(text_proj, image_proj)\n",
    "        clip_sim = clip_sim.unsqueeze(-1)  # [batch, 1]\n",
    "        \n",
    "        # Concatenate all features\n",
    "        fusion_input = torch.cat([text_proj, image_proj, abs_diff, hadamard_prod, clip_sim], dim=-1)\n",
    "        \n",
    "        # Classification\n",
    "        logits = self.fusion(fusion_input)\n",
    "        \n",
    "        return logits, {\n",
    "            'text_features': text_proj,\n",
    "            'image_features': image_proj,\n",
    "            'clip_similarity': clip_sim.squeeze(-1)\n",
    "        }\n",
    "\n",
    "# Create model\n",
    "print(\"\\nCreating model...\")\n",
    "model = MultimodalFakeNewsClassifier(freeze_encoders=True)\n",
    "model.to(device)\n",
    "\n",
    "# Count parameters\n",
    "total_params = sum(p.numel() for p in model.parameters())\n",
    "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "print(f\"\\nTotal parameters: {total_params:,}\")\n",
    "print(f\"Trainable parameters: {trainable_params:,}\")\n",
    "print(\"✅ Model defined!\")"
   ]
  },
